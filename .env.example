# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=localhost

# ─── Database ──────────────────────────────────────────────────────────────────
# TODO(human): add your MongoDB Atlas or local URI
MONGODB_URI=mongodb://localhost:27017/bildyapp

# ─── JWT ───────────────────────────────────────────────────────────────────────
# TODO(human): generate strong random secrets (e.g. `openssl rand -base64 64`)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
# TODO(human): configure your provider (Gmail / SendGrid / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bildyapp.com

# ─── Slack ─────────────────────────────────────────────────────────────────────
# TODO(human): create an Incoming Webhook in your Slack workspace
SLACK_WEBHOOK_URL=

# ─── Cloudinary (signatures + PDFs) ───────────────────────────────────────────
# TODO(human): create a free Cloudinary account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Cloudflare R2 (alternative to Cloudinary) ────────────────────────────────
# TODO(human): configure your R2 bucket in the Cloudflare dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Frontend (used in email links) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
